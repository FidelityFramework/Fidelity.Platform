<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>
  <!-- F# accepts .fs filenames. Copy the unchanged .clef sources into ignored
       obj for this managed reference runner; there is no second implementation.
       Program.fs also checks the original fidproj closures with CCS. -->
  <ItemGroup>
    <ReferenceSource Include="../../Contracts/Admission.clef" TestName="Admission" />
    <ReferenceSource Include="../../Contracts/Sidecar.clef" TestName="Sidecar" />
    <ReferenceSource Include="../../AbstractMachines/eBPF/Machine.clef" TestName="EBPF" />
    <ReferenceSource Include="../../AbstractMachines/cBPF/Machine.clef" TestName="CBPF" />
    <ReferenceSource Include="../../Environments/Linux/eBPF/Contract.clef" TestName="Linux" />
    <ReferenceSource Include="../../Environments/Windows/eBPF/Contract.clef" TestName="Windows" />
    <ReferenceSource Include="../../Environments/macOS/BPF/Contract.clef" TestName="MacBPF" />
    <ReferenceSource Include="../../Environments/macOS/Metal/Contract.clef" TestName="Metal" />
    <ReferenceSource Include="../../Environments/Linux/x86_64/ROCm/MemoryContract.clef" TestName="ROCmMemory" />
    <ReferenceSource Include="../../Profiles/StrixHalo_ArtyLab/Handoffs.clef" TestName="StrixHandoffs" />
    <ReferenceSource Include="../../Profiles/BPF_Reference/Profile.clef" TestName="Profiles" />
    <ReferenceSource Include="../../Profiles/AppleSilicon_Metal_FPGA_Reference/Handoffs.clef" TestName="Handoffs" />
    <Compile Include="@(ReferenceSource->'$(BaseIntermediateOutputPath)reference/%(TestName).fs')" />
    <Compile Include="Program.fs" />
    <ProjectReference Include="../../../BAREWire/src/BAREWire.fsproj" />
    <ProjectReference Include="../../../clef/src/Compiler/Clef.Compiler.Service.fsproj" />
  </ItemGroup>
  <Target Name="CopyReferenceSources" BeforeTargets="CoreCompile">
    <Copy SourceFiles="@(ReferenceSource)" DestinationFiles="@(ReferenceSource->'$(BaseIntermediateOutputPath)reference/%(TestName).fs')" SkipUnchangedFiles="true" />
  </Target>
</Project>
