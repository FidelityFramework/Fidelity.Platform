module ResvgIdentity

open Fidelity.Image.Resvg.Native
open Fidelity.Image.Resvg.Native.Types

[<EntryPoint>]
let main (_args: string array) : int =
    match resvg_options_create () with
    | None -> 1
    | Some options ->
        let treeOut: option<CHandle<resvg_render_tree>> array = Array.zeroCreate 1
        let parsed = resvg_parse_tree_from_file "tests/WaylandNative/identity.svg" options treeOut
        let result =
            if parsed <> 0 then 2
            else
                match Array.get treeOut 0 with
                | None -> 3
                | Some tree ->
                    let pixels: int array = Array.zeroCreate 24
                    let identity: resvg_transform = { a = 1.0; b = 0.0; c = 0.0; d = 1.0; e = 0.0; f = 0.0 }
                    resvg_render tree identity 3 2 pixels
                    resvg_tree_destroy tree
                    let mutable valid = true
                    let mutable pixel = 0
                    while pixel < 6 do
                        let offset = pixel * 4
                        if Array.get pixels offset <> 255 || Array.get pixels (offset + 1) <> 0
                           || Array.get pixels (offset + 2) <> 0 || Array.get pixels (offset + 3) <> 255 then
                            valid <- false
                        else ()
                        pixel <- pixel + 1
                    if valid then 0 else 4
        resvg_options_destroy options
        result
