type hipGraphInstantiateResult =
    | hipGraphInstantiateSuccess = 0L
    | hipGraphInstantiateError = 1L
    | hipGraphInstantiateInvalidStructure = 2L
    | hipGraphInstantiateNodeOperationNotSupported = 3L
    | hipGraphInstantiateMultipleDevicesNotSupported = 4L

