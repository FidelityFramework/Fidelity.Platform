    | hipMemHandleTypeGeneric = 0L

/// Memory operation types
type hipMemOperationType =
    | hipMemOperationTypeMap = 1L
    | hipMemOperationTypeUnmap = 2L

/// Subresource types for sparse arrays
type hipArraySparseSubresourceType =
    | hipArraySparseSubresourceTypeSparseLevel = 0L
    | hipArraySparseSubresourceTypeMiptail = 1L

type hipGraphDependencyType =
    | hipGraphDependencyTypeDefault = 0L
    | hipGraphDependencyTypeProgrammatic = 1L

