    /// Free unused memory reserved for graphs on a specific device and return it back to the OS. - Device for which memory should be trimmed #hipSuccess, #hipErrorInvalidDevice
    /// 
    /// C signature: hipError_t hipDeviceGraphMemTrim(int device)
    let hipDeviceGraphMemTrim (device: int) : Result<unit, string> =
        let result = Fidelity.ROCm.Device.hipDeviceGraphMemTrim device
        match result with
        | 0L -> Ok ()
        | err -> Error (captureHipError (int32 (err)))
