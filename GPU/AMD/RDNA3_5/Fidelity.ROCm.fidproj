[package]
name = "Fidelity.ROCm"
version = "0.1.0"
description = "Generated bindings for amdhip64."

[compilation]
target = "cpu"

[build]
output_kind = "library"
sources = [
    "StrixHalo_iGPU/Bindings/Types.clef",
    "StrixHalo_iGPU/Bindings/HipError.clef",
    "StrixHalo_iGPU/Bindings/Device/Types.clef",
    "StrixHalo_iGPU/Bindings/Device/Device.clef",
    "StrixHalo_iGPU/Bindings/Device/DeviceApi.clef",
    "StrixHalo_iGPU/Bindings/Memory/Types.clef",
    "StrixHalo_iGPU/Bindings/Memory/Memory.clef",
    "StrixHalo_iGPU/Bindings/Memory/MemoryApi.clef",
    "StrixHalo_iGPU/Bindings/Stream/Types.clef",
    "StrixHalo_iGPU/Bindings/Stream/Stream.clef",
    "StrixHalo_iGPU/Bindings/Stream/StreamApi.clef",
    "StrixHalo_iGPU/Bindings/Event/Event.clef",
    "StrixHalo_iGPU/Bindings/Event/EventApi.clef",
    "StrixHalo_iGPU/Bindings/Module/Types.clef",
    "StrixHalo_iGPU/Bindings/Module/Module.clef",
    "StrixHalo_iGPU/Bindings/Module/ModuleApi.clef",
    "StrixHalo_iGPU/Bindings/Error/Error.clef",
    "StrixHalo_iGPU/Bindings/Error/ErrorApi.clef",
]

[platform]
runtime_model = "libc"
os = "linux"
arch = "x86_64"

[dependencies]
Fidelity.Platform = { path = "../../../CPU/Linux/x86_64/Fidelity.Platform.fidproj" }
