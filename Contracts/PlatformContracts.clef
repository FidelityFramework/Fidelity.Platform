namespace Fidelity.Platform.Contracts

// NOTE:
// Composer currently imports these contracts through a restricted type-layout path.
// String-backed aliases keep call sites stable while avoiding DU layout import failures.
type SubstrateKind = string
[<RequireQualifiedAccess>]
module SubstrateKind =
    let CPU: SubstrateKind = "CPU"
    let MCU: SubstrateKind = "MCU"
    let GPU: SubstrateKind = "GPU"
    let NPU: SubstrateKind = "NPU"
    let FPGA: SubstrateKind = "FPGA"
    let CGRA: SubstrateKind = "CGRA"

type PinDirection = string
[<RequireQualifiedAccess>]
module PinDirection =
    let Input: PinDirection = "Input"
    let Output: PinDirection = "Output"
    let InOut: PinDirection = "InOut"

type ElectricalStandard = string
[<RequireQualifiedAccess>]
module ElectricalStandard =
    let LVCMOS33: ElectricalStandard = "LVCMOS33"
    let LVCMOS18: ElectricalStandard = "LVCMOS18"
    let LVDS: ElectricalStandard = "LVDS"
    let Unknown (value: string) : ElectricalStandard = value

type ActiveLevel = string
[<RequireQualifiedAccess>]
module ActiveLevel =
    let High: ActiveLevel = "High"
    let Low: ActiveLevel = "Low"

type ResetKind = string
[<RequireQualifiedAccess>]
module ResetKind =
    let External: ResetKind = "External"
    let Internal: ResetKind = "Internal"

type OsName = string          // "linux" | "windows" | "macos" | "freebsd" | "none"
type ArchName = string        // "x86_64" | "arm_cortex_m33" | "aarch64" | ...
type Endianness = string      // "little" | "big"
type RuntimeName = string     // "libc" | "freestanding" | "bare" | "rocm" | "xdna"

// The numeric vocabulary of a core (plan D8; BAREWire Platform/Tags.fs spells
// the same tags): string-aliased like every tag above.

/// The capability a target has for one numeric representation
/// (numeric-selection.md §7): native, emulated, or unavailable.
type Capability = string
[<RequireQualifiedAccess>]
module Capability =
    let Native: Capability = "native"
    let Emulated: Capability = "emulated"
    let Unavailable: Capability = "unavailable"

/// The family of a numeric representation; adding one is a declaration.
type RepresentationFamily = string
[<RequireQualifiedAccess>]
module RepresentationFamily =
    let Int: RepresentationFamily = "int"
    let UInt: RepresentationFamily = "uint"
    let Ieee: RepresentationFamily = "ieee"
    let Posit: RepresentationFamily = "posit"
    let Fixed: RepresentationFamily = "fixed"

/// What an operation does at a representation's boundary
/// (numeric-selection.md §9 item 6): a declared fact of the target.
type Boundary = string
[<RequireQualifiedAccess>]
module Boundary =
    let Wrap: Boundary = "wrap"
    let Saturate: Boundary = "saturate"
    let Exact: Boundary = "exact"

/// One named width dimension the core declares
/// (ntu-dimensional-architecture.md §7.1): the language names it, the
/// description says how many bits it is here. An undeclared dimension is a
/// located diagnostic in the compiler, never a default.
[<CLIMutable>]
type WidthDeclaration = {
    Name: string
    Bits: int
}

/// One numeric representation the target offers (platform-bindings.md,
/// descriptor requirements). MinMagnitude and MaxMagnitude bound the
/// representable range as exact decimal text.
[<CLIMutable>]
type Representation = {
    Name: string
    Capability: Capability
    Family: RepresentationFamily
    Bits: int
    MinMagnitude: string
    MaxMagnitude: string
    Boundary: Boundary
}

/// The ISA/ABI facts of a processor core (docs/CANONICAL_PLATFORM_SPEC.md,
/// "Schema: extend the live descriptor with a TargetCore block"), with the
/// width dimensions and numeric representations it declares. The twin of
/// BAREWire.Platform.TargetCore in this vocabulary.
[<CLIMutable>]
type TargetCore = {
    Os: OsName
    Arch: ArchName
    WordSizeBits: int
    Endianness: Endianness
    Runtime: RuntimeName
    /// Force a triple; else derived from (Os, Arch, Runtime).
    TripleOverride: string option
    /// -mcpu, e.g. "cortex-m33"; distinguishes M33 from M55.
    CpuModel: string option
    /// The width dimensions by name: a CPU or MCU declares Pointer and Register.
    Widths: WidthDeclaration list
    /// The numeric representations offered, each with capability, range and boundary.
    Representations: Representation list
}

[<CLIMutable>]
type PinEndpoint = {
    LogicalName: string
    PackagePin: string
    Direction: PinDirection
    Standard: ElectricalStandard
    Description: string option
}

[<CLIMutable>]
type ClockEndpoint = {
    Name: string
    FrequencyHz: int64
    PackagePin: string
    Standard: ElectricalStandard
    Description: string option
}

[<CLIMutable>]
type ResetEndpoint = {
    Name: string
    Kind: ResetKind
    PackagePin: string
    Standard: ElectricalStandard
    ActiveLevel: ActiveLevel
    Description: string option
}

[<CLIMutable>]
type EndpointGroup = {
    Name: string
    Width: int
    Pins: PinEndpoint list
    Description: string option
}

[<CLIMutable>]
type UartEndpoint = {
    Name: string
    Tx: PinEndpoint
    Rx: PinEndpoint
    DefaultBaud: int
    SupportedBaudRates: int list
    Description: string option
}

[<CLIMutable>]
type PlatformDescriptor = {
    Id: string
    DisplayName: string
    Substrate: SubstrateKind
    Vendor: string
    Family: string
    Device: string
    Package: string
    SpeedGrade: string
    /// ISA/ABI half: None for a pure-hardware leaf (an FPGA has no core to describe).
    Core: TargetCore option
    Clocks: ClockEndpoint list
    Resets: ResetEndpoint list
    Groups: EndpointGroup list
    Uarts: UartEndpoint list
    DedicatedPins: PinEndpoint list
    Notes: string list
}

module PlatformDescriptor =
    let allPins (descriptor: PlatformDescriptor) : PinEndpoint list =
        let groupPins = descriptor.Groups |> List.collect (fun g -> g.Pins)
        let uartPins =
            descriptor.Uarts
            |> List.collect (fun u -> [ u.Tx; u.Rx ])
        groupPins @ uartPins @ descriptor.DedicatedPins

    let pinMap (descriptor: PlatformDescriptor) : Map<string, PinEndpoint> =
        allPins descriptor
        |> List.map (fun p -> p.LogicalName, p)
        |> Map.ofList

    let packagePinMap (descriptor: PlatformDescriptor) : Map<string, PinEndpoint> =
        allPins descriptor
        |> List.map (fun p -> p.PackagePin, p)
        |> Map.ofList
