[package]
name = "Fidelity.Platform.Contracts"
version = "0.1.0"
authors = ["SpeakEZ Technologies"]
description = "Shared substrate-neutral contracts for Fidelity.Platform packages."

[compilation]
target = "library"

[build]
sources = [
    "PlatformContracts.clef",
    "DeviceAccess.clef"
]
output = "fidelity-platform-contracts"
output_kind = "library"

[dependencies]
BAREWire = { path = "../../BAREWire/src/BAREWire.PlatformMetadata.fidproj" }
