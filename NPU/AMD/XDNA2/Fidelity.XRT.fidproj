[package]
name = "Fidelity.XRT"
version = "0.1.0"
description = "Generated bindings for xrt_coreutil."

[compilation]
target = "cpu"

[build]
output_kind = "library"
sources = [
    "StrixHalo_NPU/Bindings/Types.clef",
    "StrixHalo_NPU/Bindings/ReturnCode.clef",
    "StrixHalo_NPU/Bindings/Device/Device.clef",
    "StrixHalo_NPU/Bindings/Device/DeviceApi.clef",
    "StrixHalo_NPU/Bindings/Buffer/Types.clef",
    "StrixHalo_NPU/Bindings/Buffer/Buffer.clef",
    "StrixHalo_NPU/Bindings/Buffer/BufferApi.clef",
    "StrixHalo_NPU/Bindings/Kernel/Types.clef",
    "StrixHalo_NPU/Bindings/Kernel/Kernel.clef",
    "StrixHalo_NPU/Bindings/Kernel/KernelApi.clef",
    "StrixHalo_NPU/Bindings/Xclbin/Xclbin.clef",
    "StrixHalo_NPU/Bindings/Xclbin/XclbinApi.clef",
    "StrixHalo_NPU/Bindings/Graph/Types.clef",
    "StrixHalo_NPU/Bindings/Graph/Graph.clef",
    "StrixHalo_NPU/Bindings/Graph/GraphApi.clef",
    "StrixHalo_NPU/Bindings/AIE/AIE.clef",
    "StrixHalo_NPU/Bindings/AIE/AIEApi.clef",
]

[platform]
runtime_model = "libc"
os = "linux"
arch = "x86_64"

[dependencies]
Fidelity.Platform = { path = "../../../CPU/Linux/x86_64/Fidelity.Platform.fidproj" }
