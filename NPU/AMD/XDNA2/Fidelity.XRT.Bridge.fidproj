[package]
name = "Fidelity.XRT.Bridge"
version = "0.1.0"
description = "Layer 2 marshaling for xrt_coreutil — protocol dispatch and callback wrappers."

[compilation]
target = "cpu"

[build]
output_kind = "library"
sources = [
    "StrixHalo_NPU/XRTBridge/Callbacks.clef",
]

[platform]
runtime_model = "libc"
os = "linux"
arch = "x86_64"
word_size = 64

[dependencies]
Fidelity.Platform = { path = "../../../CPU/Linux/x86_64/Fidelity.Platform.fidproj" }
Fidelity.XRT = { path = "Fidelity.XRT.fidproj" }
Fidelity.Libc = { path = "../../../CPU/Linux/x86_64/Fidelity.Libc.fidproj" }
