[package]
name = "Fidelity.Platform.Profile.StrixHalo_ArtyLab"
version = "0.1.0"
authors = ["SpeakEZ Technologies"]
description = "Lab profile composing Strix Halo CPU/GPU/NPU with Arty A7 FPGA."

[build]
sources = [
    "Profile.clef"
]
output = "fidelity-platform-profile-strixhalo-arty"
output_kind = "library"

[compilation]
target = "cpu"

[dependencies]
gpu = { path = "../../Hardware/Silicon/GPU/AMD/RDNA3_5/StrixHalo_iGPU/Fidelity.Platform.fidproj" }
npu = { path = "../../Hardware/Silicon/NPU/AMD/XDNA2/StrixHalo_NPU/Fidelity.Platform.fidproj" }
fpga = { path = "../../Hardware/Products/Digilent/ArtyA7_100T/Fidelity.Platform.fidproj" }
