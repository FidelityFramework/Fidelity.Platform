namespace Fidelity.Platform.Profiles.RestrictedGuest64

open BAREWire.Platform
open Fidelity.Platform.Contracts

/// Selected synthetic guest profile. Shared references retain the identity of
/// machine inventory; no boot image or runtime mapping is supplied here.
module Description =
    let core = Fidelity.Platform.Environments.Freestanding.X86_64.core
    let transport = Fidelity.Platform.Hardware.VirtualMachines.Synthetic.RestrictedGuest64.Description.transport
    let management = Fidelity.Platform.Hardware.VirtualMachines.Synthetic.RestrictedGuest64.Description.management
    let transportRegion = Fidelity.Platform.Hardware.VirtualMachines.Synthetic.RestrictedGuest64.Description.transportRegion
    let managementRegion = Fidelity.Platform.Hardware.VirtualMachines.Synthetic.RestrictedGuest64.Description.managementRegion
    let status = Fidelity.Platform.Hardware.VirtualMachines.Synthetic.RestrictedGuest64.Description.status
    let control = Fidelity.Platform.Hardware.VirtualMachines.Synthetic.RestrictedGuest64.Description.control
    let managementControl = Fidelity.Platform.Hardware.VirtualMachines.Synthetic.RestrictedGuest64.Description.managementControl
    let descriptor: PlatformDescription = {
        Id = "restricted-guest64-design-probe"; DisplayName = "Restricted 64-bit guest (synthetic)"
        Substrate = "cpu"; Core = Some core; Spaces = [| transport; management |]
        Surfaces = [||]; Buffers = [||]; Transports = [||]
        Lifecycle = { Clocks = [||]; Resets = [||]; Entry = "main"; Teardown = ""; Persistence = "volatile" }
        Notes = [| "Compiler validation only: no boot image, page tables, virtio discovery or queues." |]
        Limits = [||]
    }
