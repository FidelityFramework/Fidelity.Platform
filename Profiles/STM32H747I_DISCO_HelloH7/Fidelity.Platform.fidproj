[package]
name = "Fidelity.Platform.Profiles.STM32H747I_DISCO_HelloH7"
version = "0.1.0"
authors = ["SpeakEZ Technologies"]
description = "Historical STM32H747I-DISCO HelloH7 selection library; no companion executable. Active bring-up uses HelloDISCO."

[compilation]
target = "mcu"

[build]
sources = [
    "Description.clef"
]
output_kind = "library"

[platform]
runtime_model = "bare"
os = "none"
arch = "arm_cortex_m7"
description = "Fidelity.Platform.Profiles.STM32H747I_DISCO_HelloH7.Description.descriptor"

[dependencies]
product = { path = "../../Hardware/Products/ST/STM32H747I_DISCO/Fidelity.Platform.fidproj" }
environment = { path = "../../Environments/Freestanding/arm_cortex_m7/Fidelity.Platform.fidproj" }
