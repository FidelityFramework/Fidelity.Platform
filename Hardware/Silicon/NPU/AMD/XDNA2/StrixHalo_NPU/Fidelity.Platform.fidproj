[package]
name = "Fidelity.Platform.NPU.AMD.XDNA2.StrixHalo_NPU"
version = "0.1.0"
authors = ["SpeakEZ Technologies"]
description = "NPU substrate binding metadata for Strix Halo XDNA2."

[compilation]
target = "npu"

[build]
sources = ["Platform.clef"]
output = "fidelity-platform-npu-strixhalo"
output_kind = "library"

[platform]
description = "Fidelity.Platform.NPU.AMD.XDNA2.StrixHalo_NPU.Platform.descriptor"
runtime_model = "xdna"
arch = "xdna2"

[dependencies]
contracts = { path = "../../../../../../Contracts/Fidelity.Platform.Contracts.fidproj" }
