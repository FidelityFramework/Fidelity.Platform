[package]
name = "Fidelity.Platform.Hardware.Silicon.MCU.Espressif.ESP32S3.ESP32_S3_WROOM_1_N8"
version = "0.1.0"
authors = ["SpeakEZ Technologies"]
description = "ESP32-S3-WROOM-1-N8 memory banks, bus views, Xtensa LX7 vector layout and initial MMIO requirements."

[compilation]
target = "mcu"

[build]
sources = [
    "Description.clef",
    "Registers.clef"
]
output_kind = "library"

[dependencies]

contracts = { path = "../../../../../../Contracts/Fidelity.Platform.Contracts.fidproj" }
