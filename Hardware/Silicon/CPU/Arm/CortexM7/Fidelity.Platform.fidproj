[package]
name = "Fidelity.Platform.Hardware.Silicon.CPU.Arm.CortexM7"
version = "0.1.0"
authors = ["SpeakEZ Technologies"]
description = "STM32H74x/75x Cortex-M7 numeric specialization and Arm System Control Space register inventory."

[compilation]
target = "mcu"

[build]
sources = [
    "Description.clef",
    "Registers.clef"
]
output_kind = "library"

[dependencies]

contracts = { path = "../../../../../Contracts/Fidelity.Platform.Contracts.fidproj" }
