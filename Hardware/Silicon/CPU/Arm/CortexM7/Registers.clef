module Fidelity.Platform.Hardware.Silicon.CPU.Arm.CortexM7.Registers

open Fidelity.Platform.Contracts

// Hand-written: Arm ships no SVD for the core, so the System Control Space
// is transcribed from the Armv7-M Architecture Reference Manual (ARM DDI
// 0403E.e) register-summary tables. Offsets are relative to Description.ppb
// (0xE000_E000). Every register here is a 32-bit word transaction; SHPRn and
// NVIC_IPRn are additionally byte-accessible on the hardware (B3.2.9, B3.4.3)
// but are declared as words so a workload writes a full priority group at
// once. Inventory permits a transaction; a workload's DeviceAccessPlan grants
// it. Access is the ARM ARM's "Type" column (RO -> "r", RW -> "rw", WO -> "w").
//
// The six Cortex-M7 implementation registers at 0xF90..0xFA8 lie in the
// IMPLEMENTATION DEFINED window 0xE000EF90-0xE000EFCC (Table B3-6); their
// names and offsets are cross-checked against CMSIS core_cm7.h only, because
// the Cortex-M7 TRM (DDI0489) is not on disk. [verify: DDI0489]

let source = "ARM-DDI0403E B3.2 Tables B3-4/B3-6, B3.3 Table B3-7, B3.4 Table B3-8, B3.5 Table B3-11, B2.2 Table B2-1; Cortex-M7 implementation registers per CMSIS core_cm7.h [verify: DDI0489]"

let coreRegion: DeviceRegion = { Space = Description.ppb; AddressSpace = "cpu-physical"; Source = source }

// --- SysTick, 0xE000E010 (Table B3-7) ------------------------------
let systCsr: DeviceRegister = { Name = "systCsr"; Region = coreRegion; Offset = 0x10; TransactionBits = 32; Access = "rw"; ByteOrder = "little"; Ordering = "volatile" }
let systRvr: DeviceRegister = { Name = "systRvr"; Region = coreRegion; Offset = 0x14; TransactionBits = 32; Access = "rw"; ByteOrder = "little"; Ordering = "volatile" }
let systCvr: DeviceRegister = { Name = "systCvr"; Region = coreRegion; Offset = 0x18; TransactionBits = 32; Access = "rw"; ByteOrder = "little"; Ordering = "volatile" }
let systCalib: DeviceRegister = { Name = "systCalib"; Region = coreRegion; Offset = 0x1C; TransactionBits = 32; Access = "r"; ByteOrder = "little"; Ordering = "volatile" }

// --- NVIC, 0xE000E100 (Table B3-8). Five 32-bit words cover 160 lines; the
// STM32H747 CM7 uses IRQ 0..149 (HDR-H7 IRQn_Type, WAKEUP_PIN_IRQn = 149), so
// ICTR.INTLINESNUM = 4 and registers 0..4 are the implemented set. [verify: RM0399]
let nvicIser0: DeviceRegister = { Name = "nvicIser0"; Region = coreRegion; Offset = 0x100; TransactionBits = 32; Access = "rw"; ByteOrder = "little"; Ordering = "volatile" }
