// --- System Control Block, 0xE000ED00 (Table B3-4) ----------------------
let scbCpuid: DeviceRegister = { Name = "scbCpuid"; Region = coreRegion; Offset = 0xD00; TransactionBits = 32; Access = "r"; ByteOrder = "little"; Ordering = "volatile" }
let scbIcsr: DeviceRegister = { Name = "scbIcsr"; Region = coreRegion; Offset = 0xD04; TransactionBits = 32; Access = "rw"; ByteOrder = "little"; Ordering = "volatile" }
/// Bits[6:0] are reserved (B3.2.5): a table of 166 entries rounds its alignment up to 1024.
let scbVtor: DeviceRegister = { Name = "scbVtor"; Region = coreRegion; Offset = 0xD08; TransactionBits = 32; Access = "rw"; ByteOrder = "little"; Ordering = "volatile" }
/// Writes require VECTKEY = 0x05FA in bits[31:16].
let scbAircr: DeviceRegister = { Name = "scbAircr"; Region = coreRegion; Offset = 0xD0C; TransactionBits = 32; Access = "rw"; ByteOrder = "little"; Ordering = "volatile" }
let scbScr: DeviceRegister = { Name = "scbScr"; Region = coreRegion; Offset = 0xD10; TransactionBits = 32; Access = "rw"; ByteOrder = "little"; Ordering = "volatile" }
let scbCcr: DeviceRegister = { Name = "scbCcr"; Region = coreRegion; Offset = 0xD14; TransactionBits = 32; Access = "rw"; ByteOrder = "little"; Ordering = "volatile" }
/// Priorities of system handlers 4..7 (MemManage, BusFault, UsageFault, reserved).
let scbShpr1: DeviceRegister = { Name = "scbShpr1"; Region = coreRegion; Offset = 0xD18; TransactionBits = 32; Access = "rw"; ByteOrder = "little"; Ordering = "volatile" }
/// Priorities of system handlers 8..11 (reserved x3, SVCall).
let scbShpr2: DeviceRegister = { Name = "scbShpr2"; Region = coreRegion; Offset = 0xD1C; TransactionBits = 32; Access = "rw"; ByteOrder = "little"; Ordering = "volatile" }
/// Priorities of system handlers 12..15 (DebugMonitor, reserved, PendSV, SysTick).
let scbShpr3: DeviceRegister = { Name = "scbShpr3"; Region = coreRegion; Offset = 0xD20; TransactionBits = 32; Access = "rw"; ByteOrder = "little"; Ordering = "volatile" }
let scbShcsr: DeviceRegister = { Name = "scbShcsr"; Region = coreRegion; Offset = 0xD24; TransactionBits = 32; Access = "rw"; ByteOrder = "little"; Ordering = "volatile" }
/// MMFSR | BFSR<<8 | UFSR<<16; write-one-to-clear.
let scbCfsr: DeviceRegister = { Name = "scbCfsr"; Region = coreRegion; Offset = 0xD28; TransactionBits = 32; Access = "rw"; ByteOrder = "little"; Ordering = "volatile" }
let scbHfsr: DeviceRegister = { Name = "scbHfsr"; Region = coreRegion; Offset = 0xD2C; TransactionBits = 32; Access = "rw"; ByteOrder = "little"; Ordering = "volatile" }
let scbDfsr: DeviceRegister = { Name = "scbDfsr"; Region = coreRegion; Offset = 0xD30; TransactionBits = 32; Access = "rw"; ByteOrder = "little"; Ordering = "volatile" }
let scbMmfar: DeviceRegister = { Name = "scbMmfar"; Region = coreRegion; Offset = 0xD34; TransactionBits = 32; Access = "rw"; ByteOrder = "little"; Ordering = "volatile" }
let scbBfar: DeviceRegister = { Name = "scbBfar"; Region = coreRegion; Offset = 0xD38; TransactionBits = 32; Access = "rw"; ByteOrder = "little"; Ordering = "volatile" }
/// IMPLEMENTATION DEFINED contents; on Cortex-M7 see also ABFSR below.
let scbAfsr: DeviceRegister = { Name = "scbAfsr"; Region = coreRegion; Offset = 0xD3C; TransactionBits = 32; Access = "rw"; ByteOrder = "little"; Ordering = "volatile" }

// --- Cache identification, 0xE000ED78 (Table B4-1) ----------------------
let scbClidr: DeviceRegister = { Name = "scbClidr"; Region = coreRegion; Offset = 0xD78; TransactionBits = 32; Access = "r"; ByteOrder = "little"; Ordering = "volatile" }
let scbCtr: DeviceRegister = { Name = "scbCtr"; Region = coreRegion; Offset = 0xD7C; TransactionBits = 32; Access = "r"; ByteOrder = "little"; Ordering = "volatile" }
/// Reports the cache selected by CSSELR; the M7 line size reads back as 32 bytes (Description.cacheLineBytes).
let scbCcsidr: DeviceRegister = { Name = "scbCcsidr"; Region = coreRegion; Offset = 0xD80; TransactionBits = 32; Access = "r"; ByteOrder = "little"; Ordering = "volatile" }
let scbCsselr: DeviceRegister = { Name = "scbCsselr"; Region = coreRegion; Offset = 0xD84; TransactionBits = 32; Access = "rw"; ByteOrder = "little"; Ordering = "volatile" }

// --- Coprocessor access, 0xE000ED88 (Table B3-4) -----------------------
/// CP10/CP11 (bits[23:20]) gate the FPU; reset value is UNKNOWN per the ARM ARM and 0 on this part. Set to 0b1111, then ISB, before the first VFP instruction.
let scbCpacr: DeviceRegister = { Name = "scbCpacr"; Region = coreRegion; Offset = 0xD88; TransactionBits = 32; Access = "rw"; ByteOrder = "little"; Ordering = "volatile" }

// --- MPU (PMSAv7), 0xE000ED90 (Table B3-11) -----------------------------
/// DREGION (bits[15:8]) reports the implemented region count; Description.mpuRegions is the declared expectation.
let mpuType: DeviceRegister = { Name = "mpuType"; Region = coreRegion; Offset = 0xD90; TransactionBits = 32; Access = "r"; ByteOrder = "little"; Ordering = "volatile" }
let mpuCtrl: DeviceRegister = { Name = "mpuCtrl"; Region = coreRegion; Offset = 0xD94; TransactionBits = 32; Access = "rw"; ByteOrder = "little"; Ordering = "volatile" }
let mpuRnr: DeviceRegister = { Name = "mpuRnr"; Region = coreRegion; Offset = 0xD98; TransactionBits = 32; Access = "rw"; ByteOrder = "little"; Ordering = "volatile" }
let mpuRbar: DeviceRegister = { Name = "mpuRbar"; Region = coreRegion; Offset = 0xD9C; TransactionBits = 32; Access = "rw"; ByteOrder = "little"; Ordering = "volatile" }
let mpuRasr: DeviceRegister = { Name = "mpuRasr"; Region = coreRegion; Offset = 0xDA0; TransactionBits = 32; Access = "rw"; ByteOrder = "little"; Ordering = "volatile" }
/// Alias pairs let one STM store four regions without touching RNR (B3.5.5).
let mpuRbarA1: DeviceRegister = { Name = "mpuRbarA1"; Region = coreRegion; Offset = 0xDA4; TransactionBits = 32; Access = "rw"; ByteOrder = "little"; Ordering = "volatile" }
let mpuRasrA1: DeviceRegister = { Name = "mpuRasrA1"; Region = coreRegion; Offset = 0xDA8; TransactionBits = 32; Access = "rw"; ByteOrder = "little"; Ordering = "volatile" }
let mpuRbarA2: DeviceRegister = { Name = "mpuRbarA2"; Region = coreRegion; Offset = 0xDAC; TransactionBits = 32; Access = "rw"; ByteOrder = "little"; Ordering = "volatile" }
let mpuRasrA2: DeviceRegister = { Name = "mpuRasrA2"; Region = coreRegion; Offset = 0xDB0; TransactionBits = 32; Access = "rw"; ByteOrder = "little"; Ordering = "volatile" }
let mpuRbarA3: DeviceRegister = { Name = "mpuRbarA3"; Region = coreRegion; Offset = 0xDB4; TransactionBits = 32; Access = "rw"; ByteOrder = "little"; Ordering = "volatile" }
let mpuRasrA3: DeviceRegister = { Name = "mpuRasrA3"; Region = coreRegion; Offset = 0xDB8; TransactionBits = 32; Access = "rw"; ByteOrder = "little"; Ordering = "volatile" }

// --- Cache and branch-predictor maintenance, 0xE000EF50 (Table B2-1) ------
// Write-only operations executed by storing a word; privileged only. Set/way
// and MVA operand encodings are in B2.2.7. A read of any of these is undefined.
let scbIciallu: DeviceRegister = { Name = "scbIciallu"; Region = coreRegion; Offset = 0xF50; TransactionBits = 32; Access = "w"; ByteOrder = "little"; Ordering = "volatile" }
let scbIcimvau: DeviceRegister = { Name = "scbIcimvau"; Region = coreRegion; Offset = 0xF58; TransactionBits = 32; Access = "w"; ByteOrder = "little"; Ordering = "volatile" }
let scbDcimvac: DeviceRegister = { Name = "scbDcimvac"; Region = coreRegion; Offset = 0xF5C; TransactionBits = 32; Access = "w"; ByteOrder = "little"; Ordering = "volatile" }
let scbDcisw: DeviceRegister = { Name = "scbDcisw"; Region = coreRegion; Offset = 0xF60; TransactionBits = 32; Access = "w"; ByteOrder = "little"; Ordering = "volatile" }
let scbDccmvau: DeviceRegister = { Name = "scbDccmvau"; Region = coreRegion; Offset = 0xF64; TransactionBits = 32; Access = "w"; ByteOrder = "little"; Ordering = "volatile" }
let scbDccmvac: DeviceRegister = { Name = "scbDccmvac"; Region = coreRegion; Offset = 0xF68; TransactionBits = 32; Access = "w"; ByteOrder = "little"; Ordering = "volatile" }
let scbDccsw: DeviceRegister = { Name = "scbDccsw"; Region = coreRegion; Offset = 0xF6C; TransactionBits = 32; Access = "w"; ByteOrder = "little"; Ordering = "volatile" }
let scbDccimvac: DeviceRegister = { Name = "scbDccimvac"; Region = coreRegion; Offset = 0xF70; TransactionBits = 32; Access = "w"; ByteOrder = "little"; Ordering = "volatile" }
let scbDccisw: DeviceRegister = { Name = "scbDccisw"; Region = coreRegion; Offset = 0xF74; TransactionBits = 32; Access = "w"; ByteOrder = "little"; Ordering = "volatile" }
let scbBpiall: DeviceRegister = { Name = "scbBpiall"; Region = coreRegion; Offset = 0xF78; TransactionBits = 32; Access = "w"; ByteOrder = "little"; Ordering = "volatile" }

// --- Cortex-M7 implementation registers, 0xE000EF90 [verify: DDI0489] -----
// IMPLEMENTATION DEFINED window per Table B3-6. Offsets are CMSIS core_cm7.h
// SCB_Type offsets 0x290..0x2A8 plus the SCB base (0xD00). Access is CMSIS __IOM.
/// ITCM control: EN, RMW, RETEN, SZ. The H7 ITCM is enabled at reset. [verify: RM0399]
let scbItcmcr: DeviceRegister = { Name = "scbItcmcr"; Region = coreRegion; Offset = 0xF90; TransactionBits = 32; Access = "rw"; ByteOrder = "little"; Ordering = "volatile" }
/// DTCM control: EN, RMW, RETEN, SZ. The H7 DTCM is enabled at reset. [verify: RM0399]
let scbDtcmcr: DeviceRegister = { Name = "scbDtcmcr"; Region = coreRegion; Offset = 0xF94; TransactionBits = 32; Access = "rw"; ByteOrder = "little"; Ordering = "volatile" }
/// AHBP control: EN, SZ.
let scbAhbpcr: DeviceRegister = { Name = "scbAhbpcr"; Region = coreRegion; Offset = 0xF98; TransactionBits = 32; Access = "rw"; ByteOrder = "little"; Ordering = "volatile" }
/// L1 cache control: SIWT (shared write-through), ECCEN, FORCEWT.
let scbCacr: DeviceRegister = { Name = "scbCacr"; Region = coreRegion; Offset = 0xF9C; TransactionBits = 32; Access = "rw"; ByteOrder = "little"; Ordering = "volatile" }
/// AHBS control: CTL, TPRI, INITCOUNT.
let scbAhbscr: DeviceRegister = { Name = "scbAhbscr"; Region = coreRegion; Offset = 0xFA0; TransactionBits = 32; Access = "rw"; ByteOrder = "little"; Ordering = "volatile" }
/// Auxiliary bus fault status: ITCM, DTCM, AHBP, AXIM, EPPB, AXIMTYPE. Latch this with CFSR/BFAR in the fault handler.
let scbAbfsr: DeviceRegister = { Name = "scbAbfsr"; Region = coreRegion; Offset = 0xFA8; TransactionBits = 32; Access = "rw"; ByteOrder = "little"; Ordering = "volatile" }

