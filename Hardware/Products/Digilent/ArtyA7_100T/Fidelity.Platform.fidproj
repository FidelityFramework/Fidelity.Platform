[package]
name = "Fidelity.Platform.FPGA.Xilinx.Artix7.ArtyA7_100T"
version = "0.1.0"
authors = ["SpeakEZ Technologies"]
description = "Digilent Arty A7-100T platform binding package (FPGA substrate)."

[compilation]
target = "fpga"

[build]
sources = [
    "ArtyA7_100T.Bindings.clef",
    "Inventory.clef",
    "ArtyA7_100T.Prelude.clef"
]
output = "fidelity-platform-fpga-arty-a7-100t"
output_kind = "library"

[platform]
description = "Fidelity.Platform.FPGA.Xilinx.Artix7.ArtyA7_100T.Bindings.Platform.descriptor"
runtime_model = "bare"
substrate = "fpga"
vendor = "xilinx"
family = "artix7"
device = "xc7a100t"
clock_mhz = 100
ns_per_weight_unit = 1.6

[dependencies]
contracts = { path = "../../../../Contracts/Fidelity.Platform.Contracts.fidproj" }
silicon = { path = "../../../Silicon/FPGA/Xilinx/Artix7/XC7A100T_CSG324/Fidelity.Platform.fidproj" }
# Inventory uses BAREWire declarations; Prelude retains the library helpers.
barewire = { path = "../../../../../BAREWire/src/BAREWire.fidproj" }
