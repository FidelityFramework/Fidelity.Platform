[package]
name = "Fidelity.Libc.Runtime.Experimental"
version = "0.1.0"
description = "Existing generated libc allocation and process declarations for hosted runtimes."

[compilation]
target = "cpu"

[build]
output_kind = "library"
sources = [
    "../../Bindings/Libc/Types.clef",
    "../../Bindings/Libc/Memory/Types.clef",
    "../../Bindings/Libc/Memory/Memory.clef",
    "../../Bindings/Libc/Process/Types.clef",
    "../../Bindings/Libc/Process/Process.clef",
]

[platform]
runtime_model = "libc"
os = "linux"
arch = "x86_64"

[dependencies]
platform = { path = "../../Fidelity.Platform.fidproj" }
