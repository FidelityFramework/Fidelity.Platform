/// struct drm_mode_get_plane - Get plane metadata. Userspace can perform a GETPLANE ioctl to retrieve information about a plane. To retrieve the number of formats supported, set _format_types to zero and call the ioctl. _format_types will be updated with the value. To retrieve these formats, allocate an array with the memory needed to store _format_types formats. Point _type_ptr to this array and call the ioctl again (with _format_types still set to the value returned in the first ioctl call).
type drm_mode_get_plane = {
    plane_id: __u32
    crtc_id: __u32
    fb_id: __u32
    possible_crtcs: __u32
    gamma_size: __u32
    count_format_types: __u32
    format_type_ptr: __u64
}

type drm_mode_get_plane_res = {
    plane_id_ptr: __u64
    count_planes: __u32
}

