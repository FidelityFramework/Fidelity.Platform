/// struct drm_gem_flink - Argument for &DRM _IOCTL_GEM_FLINK ioctl. : Handle for the object being named. Create a global name for an object, returning the name. Note that the name does not hold a reference; when the object is freed, the name goes away.
type drm_gem_flink = {
    handle: uint
    name: uint
}

/// struct drm_gem_open - Argument for &DRM _IOCTL_GEM_OPEN ioctl. : Returned handle for the object. : Returned size of the object Open an object using the global name, returning a handle and the size. This handle (of course) holds a reference to the object, so the object will not go away until the handle is deleted.
type drm_gem_open = {
    name: uint
    handle: uint
    size: uint64
}

/// struct drm_gem_change_handle - Argument for &DRM _IOCTL_GEM_CHANGE_HANDLE ioctl. : The handle of a gem object. _handle: An available gem handle. This ioctl changes the handle of a GEM object to the specified one. The new handle must be unused. On success the old handle is closed and all further IOCTL should refer to the new handle only. Calls to DRM_IOCTL_PRIME_FD_TO_HANDLE will return the new handle.
type drm_gem_change_handle = {
    handle: uint
    new_handle: uint
}

