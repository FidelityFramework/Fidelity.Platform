    encoder_id: uint
    encoder_type: uint
    crtc_id: uint
    possible_crtcs: uint
    possible_clones: uint
}

/// struct drm_mode_get_connector - Get connector metadata. User-space can perform a GETCONNECTOR ioctl to retrieve information about a connector. User-space is expected to retrieve encoders, modes and properties by performing this ioctl at least twice: the first time to retrieve the number of elements, the second time to retrieve the elements themselves. To retrieve the number of elements, set _props and _encoders to zero, set _modes to 1, and set _ptr to a temporary struct drm_mode_modeinfo element. To retrieve the elements, allocate arrays for _ptr, _ptr, _ptr and _values_ptr, then set _modes, _props and _encoders to their capacity. Performing the ioctl only twice may be racy: the number of elements may have changed with a hotplug event in-between the two ioctls. User-space is expected to retry the last ioctl until the number of elements stabilizes. The kernel won't fill any array which doesn't have the expected length. **Force-probing a connector** If the _modes field is set to zero and the DRM client is the current DRM master, the kernel will perform a forced probe on the connector to refresh the connector status, modes and EDID. A forced-probe can be slow, might cause flickering and the ioctl will block. User-space needs to force-probe connectors to ensure their metadata is up-to-date at startup and after receiving a hot-plug event. User-space may perform a forced-probe when the user explicitly requests it. User-space shouldn't perform a forced-probe in other situations.
type drm_mode_get_connector = {
    encoders_ptr: uint64
    modes_ptr: uint64
    props_ptr: uint64
    prop_values_ptr: uint64
    count_modes: uint
    count_props: uint
    count_encoders: uint
    encoder_id: uint
    connector_id: uint
    connector_type: uint
    connector_type_id: uint
    connection: uint
    mm_width: uint
    mm_height: uint
    subpixel: uint
    pad: uint
}

/// struct drm_mode_property_enum - Description for an enum/bitfield entry. : numeric value for this enum entry. See struct drm_property_enum for details.
type drm_mode_property_enum = {
    value: uint64
    name: byte
}

/// struct drm_mode_get_property - Get property metadata. User-space can perform a GETPROPERTY ioctl to retrieve information about a property. The same property may be attached to multiple objects, see "Modeset Base Object Abstraction". The meaning of the _ptr field changes depending on the property type. See &drm _property.flags for more details. The property has the type &DRM _MODE_PROP_ENUM or &DRM _MODE_PROP_BITMASK. For backwards compatibility, the kernel will always set _enum_blobs to zero when the property has the type &DRM _MODE_PROP_BLOB. User-space must ignore these two fields if the property has a different type. User-space is expected to retrieve values and enums by performing this ioctl at least twice: the first time to retrieve the number of elements, the second time to retrieve the elements themselves. To retrieve the number of elements, set _values and _enum_blobs to zero, then call the ioctl. _values will be updated with the number of elements. If the property has the type &DRM _MODE_PROP_ENUM or &DRM _MODE_PROP_BITMASK, _enum_blobs will be updated as well. To retrieve the elements themselves, allocate an array for _ptr and set _values to its capacity. If the property has the type &DRM _MODE_PROP_ENUM or &DRM _MODE_PROP_BITMASK, allocate an array for again will fill the arrays.
type drm_mode_get_property = {
    values_ptr: uint64
    enum_blob_ptr: uint64
    prop_id: uint
    flags: uint
    name: byte
    count_values: uint
    count_enum_blobs: uint
}

type drm_mode_connector_set_property = {
    value: uint64
    prop_id: uint
    connector_id: uint
}

