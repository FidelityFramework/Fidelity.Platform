/// notify the source-side available actions
type WlDataOfferSourceActionsHandler = delegate of data: nativeint * wl_data_offer: nativeint * source_actions: uint32 -> unit

/// notify the selected action
type WlDataOfferActionHandler = delegate of data: nativeint * wl_data_offer: nativeint * dnd_action: uint32 -> unit

