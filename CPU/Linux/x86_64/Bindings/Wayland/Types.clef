/// fatal error event
type WlDisplayErrorHandler = delegate of data: nativeint * wl_display: nativeint * object_id: nativeint * code: uint32 * message: nativeptr<byte> -> unit

/// acknowledge object ID deletion
type WlDisplayDeleteIdHandler = delegate of data: nativeint * wl_display: nativeint * id: uint32 -> unit

/// announce global object
