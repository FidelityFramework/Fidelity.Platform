/// selection was cancelled
type WlDataSourceCancelledHandler = delegate of data: nativeint * wl_data_source: nativeint -> unit

/// the drag-and-drop operation physically finished
type WlDataSourceDndDropPerformedHandler = delegate of data: nativeint * wl_data_source: nativeint -> unit

/// the drag-and-drop operation concluded
type WlDataSourceDndFinishedHandler = delegate of data: nativeint * wl_data_source: nativeint -> unit

/// notify the selected action
type WlDataSourceActionHandler = delegate of data: nativeint * wl_data_source: nativeint * dnd_action: uint32 -> unit

/// introduce a new wl_data_offer
type WlDataDeviceDataOfferHandler = delegate of data: nativeint * wl_data_device: nativeint * id: nativeint -> unit

/// initiate drag-and-drop session
type WlDataDeviceEnterHandler = delegate of data: nativeint * wl_data_device: nativeint * serial: uint32 * surface: nativeint * x: int32 * y: int32 * id: nativeint -> unit

