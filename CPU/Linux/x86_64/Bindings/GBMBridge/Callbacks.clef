open Fidelity.GBM.Callbacks
open Fidelity.GBM.Types
open Fidelity.Libc.DynamicLink
open Fidelity.GBM
    /// Register callback by symbol name. Resolves via dlsym; passes 0n for data.
    let boSetUserData (bo: nativeint) (handlerSymbol: string) : unit =
        let handler =
            match Fidelity.Libc.DynamicLink.dlsym (Some 0n) (Some handlerSymbol.Pointer) with
            | Some v -> v
            | None -> 0n
        gbm_bo_set_user_data bo 0n handler
