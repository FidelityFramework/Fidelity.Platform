module Fidelity.Types

// Generated by Farscape — Shared type definitions

/// Format of the allocated buffer
type gbm_bo_format =
    | GBM_BO_FORMAT_XRGB8888 = 0L
    | GBM_BO_FORMAT_ARGB8888 = 1L

/// Flags to indicate the intended use for the buffer - these are passed into gbm_bo_create(). The caller must set the union of all the flags that are appropriate Use gbm_device_is_format_supported() to check if the combination of format and use flags are supported
type gbm_bo_flags =
    | GBM_BO_USE_SCANOUT = 1L
    | GBM_BO_USE_CURSOR = 2L
    | GBM_BO_USE_CURSOR_64X64 = 2L
    | GBM_BO_USE_RENDERING = 4L
    | GBM_BO_USE_WRITE = 8L
    | GBM_BO_USE_LINEAR = 16L
    | GBM_BO_USE_PROTECTED = 32L
    | GBM_BO_USE_FRONT_RENDERING = 64L
    | GBM_BO_FIXED_COMPRESSION_DEFAULT = 128L
    | GBM_BO_FIXED_COMPRESSION_1BPC = 256L
    | GBM_BO_FIXED_COMPRESSION_2BPC = 384L
    | GBM_BO_FIXED_COMPRESSION_3BPC = 512L
    | GBM_BO_FIXED_COMPRESSION_4BPC = 640L
    | GBM_BO_FIXED_COMPRESSION_5BPC = 768L
    | GBM_BO_FIXED_COMPRESSION_6BPC = 896L
    | GBM_BO_FIXED_COMPRESSION_7BPC = 1024L
    | GBM_BO_FIXED_COMPRESSION_8BPC = 1152L
    | GBM_BO_FIXED_COMPRESSION_9BPC = 1280L
    | GBM_BO_FIXED_COMPRESSION_10BPC = 1408L
    | GBM_BO_FIXED_COMPRESSION_11BPC = 1536L
    | GBM_BO_FIXED_COMPRESSION_12BPC = 1664L

/// Flags to indicate the type of mapping for the buffer - these are passed into gbm_bo_map(). The caller must set the union of all the flags that are appropriate. These flags are independent of the GBM_BO_USE_* creation flags. However, mapping the buffer may require copying to/from a staging buffer. See also: pipe_map_flags
type gbm_bo_transfer_flags =
    | GBM_BO_TRANSFER_READ = 1L
    | GBM_BO_TRANSFER_WRITE = 2L
    | GBM_BO_TRANSFER_READ_WRITE = 3L

