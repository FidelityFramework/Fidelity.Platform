module Fidelity.Pthread.Types

// Generated by Farscape — Shared type definitions

type pthread_attr_t = {
    __size: byte
    __align: int64
}

/// Cleanup buffers
type _pthread_cleanup_buffer = {
    __routine: nativeint
    __arg: nativeint
    __canceltype: int32
    __prev: nativeint
}

/// Cancellation handling with integration into exception handling.
type __cancel_jmp_buf_tag = {
    __cancel_jmp_buf: __jmp_buf
    __mask_was_saved: int32
}

/// Structure to hold the cleanup handler information.
type __pthread_cleanup_frame = {
    __cancel_routine: nativeint
    __cancel_arg: nativeint
    __do_it: int32
    __cancel_type: int32
}

// Macro constants
[<Literal>]
let PTHREAD_BARRIER_SERIAL_THREAD = -1
[<Literal>]
let PTHREAD_ONCE_INIT = 0
[<Literal>]
let PTHREAD_STACK_MIN = 16384
