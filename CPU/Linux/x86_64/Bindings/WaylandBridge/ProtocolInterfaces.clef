/// Fidelity.Wayland.Bridge.ProtocolInterfaces — Runtime wl_interface construction
/// Extension protocols constructed in Clef memory (no static linking).
module Fidelity.Wayland.Bridge.ProtocolInterfaces

/// Write a wl_message: name at +0, signature at +8, types=NULL at +16
let private writeMsg (base_: nativeint) (idx: nativeint) (name: nativeptr<byte>) (sig_: nativeptr<byte>) : unit =
    let off = idx * 24n
    let nameSlot = NativePtr.ofNativeInt<nativeptr<byte>> (base_ + off)
    NativePtr.set nameSlot 0 name
    let sigSlot = NativePtr.ofNativeInt<nativeptr<byte>> (base_ + off + 8n)
    NativePtr.set sigSlot 0 sig_
    let typesSlot = NativePtr.ofNativeInt<nativeint> (base_ + off + 16n)
    NativePtr.set typesSlot 0 0n

let private allocMessages (count: int) : nativeint =
    let size = unativeint count * unativeint 24
    match Fidelity.Libc.Memory.malloc size with
    | None -> 0n
    | Some ptr ->
    let _ = Fidelity.Libc.Memory.memset (Some ptr) 0 size
    ptr

let private buildInterface (name: nativeptr<byte>) (version: int32)
                            (methodCount: int32) (methods: nativeint)
                            (eventCount: int32) (events: nativeint) : nativeint =
    match Fidelity.Libc.Memory.malloc (unativeint 40) with
    | None -> 0n
    | Some ptr ->
    let _ = Fidelity.Libc.Memory.memset (Some ptr) 0 (unativeint 40)
    let nameSlot = NativePtr.ofNativeInt<nativeptr<byte>> ptr
    NativePtr.set nameSlot 0 name
    let intSlot = NativePtr.ofNativeInt<int32> ptr
    NativePtr.set intSlot 2 version
    NativePtr.set intSlot 3 methodCount
    let ptrSlot = NativePtr.ofNativeInt<nativeint> ptr
    NativePtr.set ptrSlot 2 methods
    NativePtr.set intSlot 6 eventCount
    NativePtr.set ptrSlot 4 events
    ptr

let xdgWmBase () : nativeint =
    let methods = allocMessages 4
    if methods = 0n then 0n
    else
    writeMsg methods 0n "destroy".Pointer "".Pointer
    writeMsg methods 1n "create_positioner".Pointer "n".Pointer
    writeMsg methods 2n "get_xdg_surface".Pointer "no".Pointer
    writeMsg methods 3n "pong".Pointer "u".Pointer
    let events = allocMessages 1
    if events = 0n then 0n
    else
    writeMsg events 0n "ping".Pointer "u".Pointer
    buildInterface "xdg_wm_base".Pointer (int32 7) (int32 4) methods (int32 1) events

let xdgPositioner () : nativeint =
    let methods = allocMessages 10
    if methods = 0n then 0n
    else
    writeMsg methods 0n "destroy".Pointer "".Pointer
    writeMsg methods 1n "set_size".Pointer "ii".Pointer
    writeMsg methods 2n "set_anchor_rect".Pointer "iiii".Pointer
    writeMsg methods 3n "set_anchor".Pointer "u".Pointer
    writeMsg methods 4n "set_gravity".Pointer "u".Pointer
    writeMsg methods 5n "set_constraint_adjustment".Pointer "u".Pointer
    writeMsg methods 6n "set_offset".Pointer "ii".Pointer
    writeMsg methods 7n "set_reactive".Pointer "3".Pointer
    writeMsg methods 8n "set_parent_size".Pointer "3ii".Pointer
    writeMsg methods 9n "set_parent_configure".Pointer "3u".Pointer
    buildInterface "xdg_positioner".Pointer (int32 7) (int32 10) methods (int32 0) 0n

