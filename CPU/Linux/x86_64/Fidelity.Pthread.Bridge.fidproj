[package]
name = "Fidelity.Pthread.Bridge"
version = "0.1.0"
description = "Layer 2 marshaling for pthread — protocol dispatch and callback wrappers."

[compilation]
target = "cpu"

[build]
output_kind = "library"
sources = [
    "Bindings/PthreadBridge/Callbacks.clef",
]

[platform]
runtime_model = "libc"
os = "linux"
arch = "x86_64"
word_size = 64

[dependencies]
Fidelity.Platform = { path = "Fidelity.Platform.fidproj" }
Fidelity.Pthread = { path = "Fidelity.Pthread.fidproj" }
Fidelity.Libc = { path = "Fidelity.Libc.fidproj" }
