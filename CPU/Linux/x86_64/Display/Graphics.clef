/// Platform.Display.Graphics — DRM render node + GBM buffer allocation
///
/// Opens a DRM render node, creates GBM device and buffer objects,
/// and exports DMA-BUF file descriptors for zero-copy presentation.
///
/// Absorbs HelloWayland's Graphics.clef.
module Platform.Display.Graphics

open Console
open Fidelity.GBM.Api
open Fidelity.Libc.IO

// ═══════════════════════════════════════════════════════════
// CONSTANTS
// ═══════════════════════════════════════════════════════════

let private renderNodePath () : string = "/dev/dri/renderD128"
let private gbmBoUseRenderingLinear () : uint32 = uint32 0x14
let private formatArgb8888 () : uint32 = uint32 0x34325241
let private formatAbgr8888 () : uint32 = uint32 0x34324241
let private gbmBoTransferWrite () : uint32 = uint32 2

// ═══════════════════════════════════════════════════════════
// GRAPHICS SETUP
// ═══════════════════════════════════════════════════════════

/// Open DRM render node and create GBM device.
/// Returns GBM device handle on success, 0n on failure.
let createDevice () : nativeint =
    let drmFd = Fidelity.Libc.IO.openat -100 (Some (renderNodePath ()).Pointer) 2
    if drmFd < 0 then
        Console.writeln "Platform.Display: Failed to open DRM render node"
        0n
    else
    match gbm_create_device drmFd with
    | None ->
        Console.writeln "Platform.Display: Failed to create GBM device"
        0n
    | Some dev -> dev

/// Allocate a GBM buffer object.
/// Returns buffer object handle on success, 0n on failure.
let allocateBufferObject (device: nativeint) (width: int) (height: int) : nativeint =
    match gbm_bo_create (Some device) (uint32 width) (uint32 height)
                        (formatArgb8888 ()) (gbmBoUseRenderingLinear ()) with
    | None ->
        Console.writeln "Platform.Display: Failed to create GBM buffer"
        0n
    | Some bo -> bo

/// Allocate a GBM buffer in ABGR8888 format (matches resvg RGBA byte order).
let allocateRgbaBuffer (device: nativeint) (width: int) (height: int) : nativeint =
    match gbm_bo_create (Some device) (uint32 width) (uint32 height)
                        (formatAbgr8888 ()) (gbmBoUseRenderingLinear ()) with
    | None ->
        Console.writeln "Platform.Display: Failed to create RGBA GBM buffer"
        0n
    | Some bo -> bo

/// Map a buffer object for writing. Returns mapped pointer, or 0n on failure.
/// Caller must allocate strideOut (4 bytes) and mapDataOut (8 bytes) before calling.
let mapBufferWrite (bo: nativeint) (width: int) (height: int)
                   (strideOut: nativeint) (mapDataOut: nativeint) : nativeint =
    match gbm_bo_map (Some bo) (uint32 0) (uint32 0)
                     (uint32 width) (uint32 height)
                     (gbmBoTransferWrite ()) (Some strideOut) (Some mapDataOut) with
    | None ->
        Console.writeln "Platform.Display: Failed to map GBM buffer"
        0n
    | Some ptr -> ptr

/// Everything a successful CPU mapping yields, in one value.
type MappedBuffer = {
    /// Base address of the mapping.
    Mapped: nativeint
    /// Bytes per row, which may exceed width * 4.
    Stride: int
    /// Opaque token gbm requires back at unmap.
    MapData: nativeint
}

/// Map a buffer object for CPU write.
///
/// `mapBufferWrite` returns one value and delivers two more through C
/// out-parameters, so every caller had to allocate two scratch slots, thread
/// them through its own signature, and — the part that actually bites —
/// remember that gbm requires `*map_data == NULL` on entry. That precondition
/// was satisfied by writing 0n at each call site: correct, invisible, and one
/// edit away from being silently dropped, with undefined behaviour and no
/// diagnostic as the failure mode.
///
/// Here the scratch and the precondition are owned by the wrapper and the
/// three results come back as one value. This is the membrane the boundary
/// spec describes: C out-parameter mechanics stay on this side of it.
let mapBufferForWrite (bo: nativeint) (width: int) (height: int)
                      : option<MappedBuffer> =
    match Fidelity.Libc.Memory.malloc (unativeint 4) with
    | None -> None
    | Some strideOut ->

    match Fidelity.Libc.Memory.malloc (unativeint 8) with
    | None ->
        Fidelity.Libc.Memory.free (Some strideOut) |> ignore
        None
    | Some mapDataOut ->

    // the gbm contract, enforced once instead of at every call site
    NativePtr.write (NativePtr.ofNativeInt<nativeint> mapDataOut) 0n
    let ptr = mapBufferWrite bo width height strideOut mapDataOut
    let result =
        if ptr = 0n then None
        else
            Some { Mapped = ptr
                   Stride = int (NativePtr.read (NativePtr.ofNativeInt<uint32> strideOut))
                   MapData = NativePtr.read (NativePtr.ofNativeInt<nativeint> mapDataOut) }
    Fidelity.Libc.Memory.free (Some strideOut) |> ignore
    Fidelity.Libc.Memory.free (Some mapDataOut) |> ignore
    result

/// Unmap a previously mapped buffer.
let unmapBuffer (bo: nativeint) (mapData: nativeint) : unit =
    gbm_bo_unmap (Some bo) (Some mapData)

/// Get the stride (bytes per row) of a buffer object.
let getBufferStride (bo: nativeint) : int =
    int (gbm_bo_get_stride (Some bo))

/// Get the pixel format of a buffer object.
let getBufferFormat (bo: nativeint) : uint32 =
    gbm_bo_get_format (Some bo)

/// Export DMA-BUF file descriptor from a buffer object.
let getBufferFd (bo: nativeint) : int =
    gbm_bo_get_fd (Some bo)

/// Destroy a buffer object.
let destroyBuffer (bo: nativeint) : unit =
    gbm_bo_destroy (Some bo)
