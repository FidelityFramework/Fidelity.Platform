/// Platform.Display.Surface — Wayland surface + xdg shell management
///
/// Creates xdg toplevel surfaces, manages listeners, and handles
/// buffer attachment + frame presentation.
///
/// All handles are nativeint (CCS FieldLabels workaround — will be
/// replaced with typed opaque handles when .clefi lands).
module Platform.Display.Surface

open Console
open Fidelity.Wayland.Core
open Fidelity.Wayland.Core.Api
open Fidelity.Wayland.Bridge.Protocol
open Fidelity.Wayland.Bridge.XdgShell
open Fidelity.Wayland.Bridge.DmaBuf
open Fidelity.Wayland.Bridge.Callbacks

// ═══════════════════════════════════════════════════════════
// SURFACE CREATION
// ═══════════════════════════════════════════════════════════

/// Create an xdg toplevel surface with the given title.
/// Handles the full protocol choreography:
///   compositor.create_surface → xdg_wm_base.get_xdg_surface →
///   xdg_surface.get_toplevel → set_title → set_app_id → commit → roundtrip
///
/// Returns the wl_surface handle for buffer attachment, or None on failure.
let createToplevel (display: nativeint) (compositor: nativeint)
                   (xdgWmBase: nativeint) (closeFlag: nativeint)
                   (title: string) (appId: string) : option<nativeint> =
    // xdg_wm_base ping listener
    let wmBaseListener = buildXdgWmBaseListener
                            "Platform.Display.Callbacks.wmBasePing"

    // Create wl_surface
    match wl_compositor_create_surface compositor with
    | None ->
        Console.writeln "Platform.Display: Failed to create surface"
        None
    | Some surf ->

    // Get xdg_surface from wl_surface
    match xdg_wm_base_get_xdg_surface xdgWmBase surf with
    | None ->
        Console.writeln "Platform.Display: Failed to get xdg_surface"
        None
    | Some xdgSurf ->

    let xdgSurfaceListener = buildXdgSurfaceListener
                                "Platform.Display.Callbacks.surfaceConfigure"
    wl_proxy_add_listener (Some xdgSurf) (nativeint &xdgSurfaceListener) (Some 0n) |> ignore

    // Get toplevel from xdg_surface
    match xdg_surface_get_toplevel xdgSurf with
    | None ->
        Console.writeln "Platform.Display: Failed to get toplevel"
        None
    | Some tl ->

    let toplevelListener = buildXdgToplevelListener
                            "Platform.Display.Callbacks.toplevelConfigure"
                            "Platform.Display.Callbacks.toplevelClose"
                            "Platform.Display.Callbacks.toplevelConfigureBounds"
                            "Platform.Display.Callbacks.toplevelWmCapabilities"
    wl_proxy_add_listener (Some tl) (nativeint &toplevelListener) (Some closeFlag) |> ignore

    let titlePtr = nativeint title.Pointer
    let appIdPtr = nativeint appId.Pointer
    xdg_toplevel_set_title tl titlePtr
    xdg_toplevel_set_app_id tl appIdPtr

    // Initial commit triggers configure sequence
    wl_surface_commit surf
    wl_display_roundtrip (Some display) |> ignore

    Some surf

// ═══════════════════════════════════════════════════════════
// BUFFER PRESENTATION
// ═══════════════════════════════════════════════════════════

/// Import a DMA-BUF and present it on the surface.
/// Handles: create_params → add → create_immed → attach → damage → commit
let presentDmaBuf (surface: nativeint) (dmabuf: nativeint)
                  (dmaBufFd: int) (width: int) (height: int)
                  (stride: int) (format: uint32) : unit =
    match zwp_linux_dmabuf_v1_create_params dmabuf with
    | None ->
        Console.writeln "Platform.Display: Failed to create buffer params"
    | Some bufParams ->

    // Add the DMA-BUF fd BEFORE creating the buffer
    zwp_linux_buffer_params_v1_add bufParams (int32 dmaBufFd)
        (uint32 0) (uint32 0) (uint32 stride) (uint32 0) (uint32 0)

    match zwp_linux_buffer_params_v1_create_immed bufParams
                    (int32 width) (int32 height) format (uint32 0) with
    | None ->
        Console.writeln "Platform.Display: Failed to create buffer"
        zwp_linux_buffer_params_v1_destroy bufParams
    | Some buffer ->
    zwp_linux_buffer_params_v1_destroy bufParams

    wl_surface_attach surface buffer (int32 0) (int32 0)
    wl_surface_damage_buffer surface (int32 0) (int32 0) (int32 width) (int32 height)
    wl_surface_commit surface

/// Commit the surface (triggers compositor to display current buffer).
let commit (surface: nativeint) : unit =
    wl_surface_commit surface
