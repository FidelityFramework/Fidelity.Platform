/// Platform.Display.Callbacks — Protocol callback implementations
///
/// These functions are compiled to native symbols, resolved at runtime
/// via dlsym(RTLD_DEFAULT, "Platform.Display.Callbacks.*") by the
/// listener builder functions in Fidelity.Wayland.Bridge.
///
/// Callback parameters are ABI-fixed (nativeint from the Wayland C runtime).
/// Protocol dispatch functions take nativeint directly (CCS FieldLabels
/// workaround), so no handle wrapping is needed.
/// This is the membrane — C idioms (NativePtr, strcmp, dlsym) are correct here.
module Platform.Display.Callbacks

open Fidelity.Wayland.Bridge.Protocol
open Fidelity.Wayland.Bridge.XdgShell
open Fidelity.Wayland.Bridge.ProtocolInterfaces

// ═══════════════════════════════════════════════════════════
// REGISTRY CALLBACKS
// ═══════════════════════════════════════════════════════════

/// Called for each global object in the Wayland registry.
/// data points to a malloc'd buffer of 3 nativeint slots:
///   [0] = compositor, [1] = xdg_wm_base, [2] = dmabuf
let registryGlobal (data: nativeint) (registry: nativeint) (name: uint32)
                    (iface: nativeptr<byte>) (version: uint32) : unit =
    let dataPtr = NativePtr.ofNativeInt data
    if Fidelity.Libc.String.strcmp (Some iface) (Some "wl_compositor".Pointer) = 0 then
        let ifacePtr =
            match Fidelity.Libc.DynamicLink.dlsym (Some 0n) (Some "wl_compositor_interface".Pointer) with
            | Some v -> v
            | None -> 0n
        match wl_registry_bind registry name ifacePtr (uint32 4) with
        | Some bound -> let _ = NativePtr.set dataPtr 0 bound in ()
        | None -> ()
    else
        ()
    if Fidelity.Libc.String.strcmp (Some iface) (Some "xdg_wm_base".Pointer) = 0 then
        let ifacePtr = xdgWmBase ()
        match wl_registry_bind registry name ifacePtr (uint32 2) with
        | Some bound -> let _ = NativePtr.set dataPtr 1 bound in ()
        | None -> ()
    else
        ()
    if Fidelity.Libc.String.strcmp (Some iface) (Some "zwp_linux_dmabuf_v1".Pointer) = 0 then
        let ifacePtr = zwpLinuxDmabufV1 ()
        match wl_registry_bind registry name ifacePtr (uint32 3) with
        | Some bound -> let _ = NativePtr.set dataPtr 2 bound in ()
        | None -> ()
    else
        ()

/// Called when a global object is removed from the registry.
let registryGlobalRemove (data: nativeint) (registry: nativeint)
                          (name: uint32) : unit =
    ()

// ═══════════════════════════════════════════════════════════
// XDG SHELL CALLBACKS
// ═══════════════════════════════════════════════════════════

/// Respond to xdg_wm_base ping with pong (keep-alive).
let wmBasePing (data: nativeint) (wmBase: nativeint) (serial: uint32) : unit =
    xdg_wm_base_pong wmBase serial

/// Acknowledge xdg_surface configure event.
let surfaceConfigure (data: nativeint) (xdgSurface: nativeint)
                      (serial: uint32) : unit =
    xdg_surface_ack_configure xdgSurface serial

// ═══════════════════════════════════════════════════════════
// TOPLEVEL CALLBACKS
// ═══════════════════════════════════════════════════════════

/// Handle toplevel configure (resize/state change).
let toplevelConfigure (data: nativeint) (toplevel: nativeint)
                       (width: int32) (height: int32)
                       (states: nativeint) : unit =
    ()

/// Handle toplevel close request.
/// data points to a single nativeint slot; set it to 1n to signal close.
let toplevelClose (data: nativeint) (toplevel: nativeint) : unit =
    let dataPtr = NativePtr.ofNativeInt data
    let _ = NativePtr.set dataPtr 0 1n
    ()

/// Handle toplevel configure bounds.
let toplevelConfigureBounds (data: nativeint) (toplevel: nativeint)
                             (width: int32) (height: int32) : unit =
    ()

/// Handle toplevel window manager capabilities.
let toplevelWmCapabilities (data: nativeint) (toplevel: nativeint)
                            (capabilities: nativeint) : unit =
    ()
