[package]
name = "Fidelity.Platform.Linux_x86_64"
version = "0.1.0"
authors = ["SpeakEZ Technologies"]
description = "Linux x86-64 platform bindings."

[compilation]
target = "cpu"

[build]
sources = [
    "Types.clef",
    "Helpers.clef",
    "Syscalls.clef",
    "Format.clef",
    "Parse.clef",
    "Console.clef",
    "WebView.clef",
    "WebViewWrapper.clef"
]

[platform]
runtime_model = "libc"
os = "linux"
arch = "x86_64"
word_size = 64

[dependencies]
# BAREWire will be added when WebSocket bindings need it
# For now, Console/WebView only need CCS intrinsics