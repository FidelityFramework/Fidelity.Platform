[package]
name = "Fidelity.Platform.Linux_x86_64"
version = "0.1.0"
authors = ["SpeakEZ Technologies"]
description = "Linux x86-64 platform bindings."

[compilation]
target = "cpu"

[build]
sources = [
    "Types.clef",
    "Format.clef",
    "Parse.clef",
    "Console.clef",
    "WebView.clef",
    "WebViewWrapper.clef",
    # Generated Wayland bindings (Farscape)
    "Bindings/Wayland/Types.clef",
    "Bindings/Wayland/Core/Types.clef",
    "Bindings/Wayland/Core/Core.clef",
    "Bindings/Wayland/Core/CoreWrappers.clef",
    "Bindings/Wayland/Core/CoreOverlay.clef",
    "Bindings/Wayland/Protocol/Types.clef",
    "Bindings/Wayland/Protocol/Protocol.clef",
    "Bindings/Wayland/Protocol/ProtocolWrappers.clef",
    "Bindings/Wayland/XdgShell/Types.clef",
    "Bindings/Wayland/XdgShell/XdgShell.clef",
    "Bindings/Wayland/XdgShell/XdgShellWrappers.clef",
    "Bindings/Wayland/DmaBuf/Types.clef",
    "Bindings/Wayland/DmaBuf/DmaBuf.clef",
    "Bindings/Wayland/DmaBuf/DmaBufWrappers.clef",
    # Generated libc bindings (Farscape)
    "Bindings/Libc/Types.clef",
    "Bindings/Libc/IO/IO.clef",
    "Bindings/Libc/IO/IOWrappers.clef",
    "Bindings/Libc/Memory/Types.clef",
    "Bindings/Libc/Memory/Memory.clef",
    "Bindings/Libc/Memory/MemoryWrappers.clef",
    "Bindings/Libc/Socket/Types.clef",
    "Bindings/Libc/Socket/Socket.clef",
    "Bindings/Libc/Socket/SocketWrappers.clef",
    "Bindings/Libc/Process/Types.clef",
    "Bindings/Libc/Process/Process.clef",
    "Bindings/Libc/Process/ProcessWrappers.clef",
    "Bindings/Libc/FileStat/Types.clef",
    "Bindings/Libc/FileStat/FileStat.clef",
    "Bindings/Libc/FileStat/FileStatWrappers.clef",
    "Bindings/Libc/String/String.clef",
    "Bindings/Libc/String/StringWrappers.clef",
    "Bindings/Libc/DynamicLink/DynamicLink.clef",
    "Bindings/Libc/DynamicLink/DynamicLinkWrappers.clef",
    # Generated pthread bindings (Farscape)
    "Bindings/Pthread/Types.clef",
    "Bindings/Pthread/Thread/Types.clef",
    "Bindings/Pthread/Thread/Thread.clef",
    "Bindings/Pthread/Thread/ThreadWrappers.clef",
    "Bindings/Pthread/Mutex/Mutex.clef",
    "Bindings/Pthread/Mutex/MutexWrappers.clef",
    "Bindings/Pthread/Cond/Types.clef",
    "Bindings/Pthread/Cond/Cond.clef",
    "Bindings/Pthread/Cond/CondWrappers.clef",
    "Bindings/Pthread/Attr/Attr.clef",
    "Bindings/Pthread/Attr/AttrWrappers.clef",
    # Generated DRM bindings (Farscape)
    "Bindings/DRM/Types.clef",
    "Bindings/DRM/Core/Types.clef",
    "Bindings/DRM/Core/Core.clef",
    "Bindings/DRM/Core/CoreWrappers.clef",
    "Bindings/DRM/Mode/Types.clef",
    "Bindings/DRM/Mode/Mode.clef",
    "Bindings/DRM/Mode/ModeWrappers.clef",
    # Generated GBM bindings (Farscape)
    "Bindings/GBM/Types.clef",
    "Bindings/GBM/GBM/GBM.clef",
    "Bindings/GBM/GBM/GBMWrappers.clef",
]

[platform]
runtime_model = "libc"
os = "linux"
arch = "x86_64"
word_size = 64

[dependencies]
# BAREWire will be added when WebSocket bindings need it
# For now, Console/WebView only need FNCS intrinsics