[package]
name = "Fidelity.Platform.Linux_x86_64"
version = "0.1.0"
authors = ["SpeakEZ Technologies"]
description = "Linux x86-64 platform bindings."

[compilation]
target = "cpu"

[build]
sources = [
    "Types.clef",
    "Helpers.clef",
    "Syscalls.clef",
    "Format.clef",
    "Parse.clef",
    "Console.clef",
    "Description.clef",
    "WebView.clef",
    "WebViewWrapper.clef"
]

[platform]
runtime_model = "libc"
os = "linux"
arch = "x86_64"

[dependencies]
# BAREWire supplies the vocabulary Description.clef declares this platform in
# (BAREWire docs/11); its sources are spliced ahead of this tree's.
barewire = { path = "../../../../BAREWire/src/BAREWire.fidproj" }
