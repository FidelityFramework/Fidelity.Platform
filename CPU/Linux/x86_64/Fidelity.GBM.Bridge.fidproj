[package]
name = "Fidelity.GBM.Bridge"
version = "0.1.0"
description = "Layer 2 marshaling for gbm — protocol dispatch and callback wrappers."

[compilation]
target = "cpu"

[build]
output_kind = "library"
sources = [
    "Bindings/GBMBridge/Callbacks.clef",
]

[platform]
runtime_model = "libc"
os = "linux"
arch = "x86_64"
word_size = 64

[dependencies]
Fidelity.Platform = { path = "Fidelity.Platform.fidproj" }
Fidelity.GBM = { path = "Fidelity.GBM.fidproj" }
Fidelity.Libc = { path = "Fidelity.Libc.fidproj" }
