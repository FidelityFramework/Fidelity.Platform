# The same target declaration consumed by native compiler and binding probes.
# Console supplies the declared read-buffer capacity and optional console I/O.
[package]
name = "Fidelity.Platform.Linux_x86_64.CompilerSurface"
version = "0.1.0"
[compilation]
target = "cpu"
[dependencies]
barewire = { path = "../../../../BAREWire/src/BAREWire.PlatformMetadata.fidproj" }
[platform]
runtime_model = "libc"
os = "linux"
arch = "x86_64"
[build]
output_kind = "library"
sources = ["Console.clef", "Description.clef"]
