namespace Fidelity.Platform.Environments.Freestanding.Arm_Cortex_M7

open BAREWire.Platform

module Core = Fidelity.Platform.Hardware.Silicon.CPU.Arm.CortexM7.Description

/// Hard-float ABI for the STM32H74x/75x Cortex-M7 implementation represented
/// by this core package. Not a promise that every Cortex-M7 has a DP FPU.
/// Startup, FPU enablement, actual clock state and core ownership are image-owned.
module Description =
    let pointerWidth: WidthDeclaration = { Name = "Pointer"; Bits = 32 }
    let core: TargetCore = {
        Os = "none"
        Arch = Core.architecture
        WordSizeBits = Core.wordSizeBits
        Endianness = Core.endianness
        Runtime = "bare"
        Triple = "thumbv7em-none-eabihf"
        CpuModel = Core.cpuModel
        Widths = [| pointerWidth; Core.registerWidth |]
        Representations = [| Core.repInt8; Core.repInt16; Core.repInt32; Core.repInt64
                             Core.repUInt8; Core.repUInt16; Core.repUInt32; Core.repUInt64
                             Core.repIeee32; Core.repIeee64 |]
    }

