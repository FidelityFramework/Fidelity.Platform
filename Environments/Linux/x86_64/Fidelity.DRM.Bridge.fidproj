[package]
name = "Fidelity.DRM.Bridge"
version = "0.1.0"
description = "Layer 2 marshaling for drm — protocol dispatch and callback wrappers."

[compilation]
target = "cpu"

[build]
output_kind = "library"
sources = [
    "Bindings/DRMBridge/Callbacks.clef",
]

[platform]
runtime_model = "libc"
os = "linux"
arch = "x86_64"

[dependencies]
Fidelity.Platform = { path = "Fidelity.Platform.fidproj" }
Fidelity.DRM = { path = "Fidelity.DRM.fidproj" }
Fidelity.Libc = { path = "Fidelity.Libc.fidproj" }
