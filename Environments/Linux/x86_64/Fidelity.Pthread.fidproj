[package]
name = "Fidelity.Pthread"
version = "0.1.0"
description = "Generated bindings for pthread."

[compilation]
target = "cpu"

[build]
output_kind = "library"
sources = [
    "Bindings/Pthread/Types.clef",
    "Bindings/Pthread/Thread/Thread.clef",
    "Bindings/Pthread/Mutex/Mutex.clef",
    "Bindings/Pthread/Cond/Cond.clef",
    "Bindings/Pthread/Storage/Storage.clef",
    "Bindings/Pthread/Affinity/Affinity.clef",
]

[platform]
runtime_model = "libc"
os = "linux"
arch = "x86_64"
word_size = 64

[dependencies]
BAREWire = { path = "../../../../BAREWire/src/BAREWire.BindingMetadata.fidproj" }
