module Fidelity.Libc.Bridge.Callbacks

// Generated by Farscape — Callback wrappers — dlsym-based runtime symbol resolution

open Fidelity.Libc.Callbacks
open Fidelity.Libc.Types
open Fidelity.Libc.DynamicLink
open Fidelity.Libc.Process
    /// Register callback by symbol name. Resolves via dlsym.
    let atexit (handlerSymbol: string) : int =
        let handler =
            match Fidelity.Libc.DynamicLink.dlsym (Some 0n) (Some handlerSymbol.Pointer) with
            | Some v -> v
            | None -> 0n
        atexit handler
