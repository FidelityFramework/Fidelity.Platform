    /// Opaque handle wrapping a native pointer.
[<Struct>]
type hipFunction_t = {
    Handle: nativeint
}

module hipFunction_t =
        let zero () : hipFunction_t =
            NativeDefault.zeroed ()

        let isNull (h: hipFunction_t) : bool =
            h.Handle = 0n

        let ofHandle (h: nativeint) : hipFunction_t =
            let mutable s = NativeDefault.zeroed ()
            let p = NativePtr.ofNativeInt<nativeint> (nativeint &s)
            NativePtr.write p h
            s



