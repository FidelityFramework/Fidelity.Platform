[package]
name = "Fidelity.Display.Native"
version = "0.1.0"
description = "Generated bindings for c."

[compilation]
target = "cpu"

[build]
output_kind = "library"
sources = [
    "Bindings/DisplayNative/Types.clef",
    "Bindings/DisplayNative/Native/Native.clef",
]

[platform]
runtime_model = "libc"
os = "linux"
arch = "x86_64"
word_size = 64

[dependencies]
BAREWire = { path = "../../../../BAREWire/src/BAREWire.BindingMetadata.fidproj" }
