/// Console I/O operations for Fidelity.Platform
/// Writes explicitly borrow immutable string bytes with that string's extent.
/// CCS/Baker settles storage, bounds and the selected endpoint's ABI.
///
/// NOTE: Top-level module declaration provides "Console.readln" etc. directly matching
/// the intrinsic names for write/writeln/error/errorln. This allows user code to
/// call Console.* uniformly.
module Console

/// Standard file descriptors
[<Literal>]
let STDIN = 0

[<Literal>]
let STDOUT = 1

[<Literal>]
let STDERR = 2

/// Read a line from stdin, returning it as a string.
/// Requires its own source-owned input buffer contract before native admission.
let readln () : string =
    Sys.readline STDIN

/// Write a string to stdout.
let write (s: string) : unit =
    let _ = Sys.write STDOUT s.Bytes s.Length
    ()

/// Write a string to stdout followed by newline.
let writeln (s: string) : unit =
    write s
    let newline = "\n"
    let _ = Sys.write STDOUT newline.Bytes newline.Length
    ()

/// Write a string to stderr.
let error (s: string) : unit =
    let _ = Sys.write STDERR s.Bytes s.Length
    ()

/// Write a string to stderr followed by newline.
let errorln (s: string) : unit =
    error s
    let newline = "\n"
    let _ = Sys.write STDERR newline.Bytes newline.Length
    ()

/// Capacity in bytes of the line buffer `readln` reads into. Authored here
/// once as a library API constraint. The selected profile's `Description.clef`
/// references it as the `consoleReadln` buffer schema,
/// and the compiler's `Sys.readline` lowering and the input-bound proof
/// obligations read it from that declaration, never from a literal of their
/// own (BAREWire docs/11, "three observers, one truth").
[<Literal>]
let READLINE_CAPACITY = 1024
