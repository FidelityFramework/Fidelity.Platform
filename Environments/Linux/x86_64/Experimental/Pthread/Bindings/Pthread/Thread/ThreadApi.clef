module Fidelity.Pthread.Thread.Api

// Generated by Farscape — c

open Fidelity.Pthread.Thread
open Fidelity.Pthread.ReturnCode

/// Capture Pthread return code as human-readable error string.
let captureReturnCode (code: int) : string =
    describe code



/// Create a new thread, starting with execution of START-ROUTINE getting passed ARG.  Creation attributed come from ATTR.  The new handle is stored in *NEWTHREAD.
///
/// C signature: int pthread_create(pthread_t *restrict __newthread, const pthread_attr_t *restrict __attr, void *(*)(void *) __start_routine, void *restrict __arg)
let pthread_create (newthread: nativeint) (attr: nativeint) (start_routine: FnPtr<nativeint -> nativeint>) (arg: nativeint) : Result<unit, string> =
    let result = Fidelity.Pthread.Thread.pthread_create newthread attr start_routine arg
    if result = 0l then Ok ()
    else Error (captureReturnCode (int (result)))

/// Terminate calling thread. The registered cleanup handlers are called via exception handling so we cannot mark this function with __THROW.
///
/// C signature: void pthread_exit(void * __retval)
let pthread_exit (retval: nativeint) : unit =
    Fidelity.Pthread.Thread.pthread_exit retval

/// Make calling thread wait for termination of the thread TH.  The exit status of the thread is stored in *THREAD_RETURN, if THREAD_RETURN is not NULL. This function is a cancellation point and therefore not marked with __THROW.
///
/// C signature: int pthread_join(pthread_t __th, void ** __thread_return)
let pthread_join (th: uint64) (thread_return: nativeint) : Result<unit, string> =
    let result = Fidelity.Pthread.Thread.pthread_join th thread_return
    if result = 0l then Ok ()
    else Error (captureReturnCode (int (result)))

/// Indicate that the thread TH is never to be joined with PTHREAD_JOIN. The resources of TH will therefore be freed immediately when it terminates, instead of waiting for another thread to perform PTHREAD_JOIN on it.
///
/// C signature: int pthread_detach(pthread_t __th)
let pthread_detach (th: uint64) : Result<unit, string> =
    let result = Fidelity.Pthread.Thread.pthread_detach th
    if result = 0l then Ok ()
    else Error (captureReturnCode (int (result)))

/// Obtain the identifier of the current thread.
///
/// C signature: pthread_t pthread_self()
let pthread_self () : uint64 =
    Fidelity.Pthread.Thread.pthread_self ()

/// Compare two thread identifiers.
///
/// C signature: int pthread_equal(pthread_t __thread1, pthread_t __thread2)
let pthread_equal (thread1: uint64) (thread2: uint64) : int32 =
    Fidelity.Pthread.Thread.pthread_equal thread1 thread2

/// Guarantee that the initialization function INIT_ROUTINE will be called only once, even if pthread_once is executed several times with the same ONCE_CONTROL argument. ONCE_CONTROL must point to a static or extern variable initialized to PTHREAD_ONCE_INIT. The initialization functions might throw exception which is why this function is not marked with __THROW.
///
/// C signature: int pthread_once(pthread_once_t * __once_control, void (*)(void) __init_routine)
let pthread_once (once_control: nativeint) (init_routine: FnPtr<unit -> unit>) : Result<unit, string> =
    let result = Fidelity.Pthread.Thread.pthread_once once_control init_routine
    if result = 0l then Ok ()
    else Error (captureReturnCode (int (result)))

/// Cancel THREAD immediately or at the next possibility.
///
/// C signature: int pthread_cancel(pthread_t __th)
let pthread_cancel (th: uint64) : Result<unit, string> =
    let result = Fidelity.Pthread.Thread.pthread_cancel th
    if result = 0l then Ok ()
    else Error (captureReturnCode (int (result)))
