open Fidelity.Pthread.Mutex
open Fidelity.Pthread.ReturnCode

/// Capture Pthread return code as human-readable error string.
let captureReturnCode (code: int) : string =
    describe code



/// Initialize a mutex.
///
/// C signature: int pthread_mutex_init(pthread_mutex_t * __mutex, const pthread_mutexattr_t * __mutexattr)
let pthread_mutex_init (mutex: nativeint) (mutexattr: nativeint) : Result<unit, string> =
    let result = Fidelity.Pthread.Mutex.pthread_mutex_init mutex mutexattr
    if result = 0l then Ok ()
    else Error (captureReturnCode (int (result)))

