[package]
name = "Fidelity.Image.Resvg.Native"
version = "0.1.0"
description = "Generated bindings for resvg."

[compilation]
target = "cpu"

[build]
output_kind = "library"
sources = [
    "Bindings/ResvgNative/Types.clef",
    "Bindings/ResvgNative/Native/Native.clef",
]

[link]
libraries = ["resvg"]

[platform]
runtime_model = "libc"
os = "linux"
arch = "x86_64"
word_size = 64

[dependencies]
BAREWire = { path = "../../../../BAREWire/src/BAREWire.BindingMetadata.fidproj" }
