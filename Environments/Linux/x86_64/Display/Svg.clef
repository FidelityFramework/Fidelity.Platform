/// Platform.Display.Svg — SVG rasterization via resvg
///
/// Parses SVG files and rasterizes them into pixel buffers.
///
/// Absorbs HelloWayland's Rendering.clef.
/// Uses L1 bindings directly (fully qualified) to avoid L2 sub-module
/// resolution issues with errno/error describe functions.
module Platform.Display.Svg

open Console

// ═══════════════════════════════════════════════════════════
// SVG RASTERIZATION
// ═══════════════════════════════════════════════════════════

/// Rasterize an SVG file into a pixel buffer, applying a CSS stylesheet.
///
/// The stylesheet is applied at parse time, so it can select on the ids and
/// classes in the document — which makes one asset able to carry several
/// variants and have the caller choose between them. Toggling a `display`
/// is the usual case: a document that holds both a CPU and a GPU row can be
/// rendered either way without duplicating the file, and elements with
/// explicit coordinates do not reflow when a sibling is hidden.
///
/// Pass an empty string for no stylesheet; `rasterize` is exactly this with
/// none supplied.
///
/// Returns pixel buffer handle on success, 0n on failure.
/// Caller is responsible for freeing the buffer via freePixmap.
let rasterizeStyled (svgPath: string) (width: int) (height: int)
                    (css: string) : nativeint =
    let bufferSize = width * height * 4

    match Fidelity.Image.Resvg.resvg_options_create () with
    | None ->
        Console.writeln "Platform.Display: resvg_options_create failed"
        0n
    | Some opts ->
        Fidelity.Image.Resvg.resvg_options_load_system_fonts (Some opts)
        if String.length css > 0 then
            Fidelity.Image.Resvg.resvg_options_set_stylesheet (Some opts) (Some css.Pointer)
        else
            ()

        match Fidelity.Libc.Memory.malloc (unativeint 8) with
        | None ->
            Console.writeln "Platform.Display: tree storage malloc failed"
            Fidelity.Image.Resvg.resvg_options_destroy (Some opts)
            0n
        | Some treePtrStorage ->

        let parseResult = int (Fidelity.Image.Resvg.resvg_parse_tree_from_file (Some svgPath.Pointer) (Some opts) (Some treePtrStorage))
        if parseResult <> 0 then
            Console.writeln "Platform.Display: SVG parse failed"
            Fidelity.Libc.Memory.free (Some treePtrStorage)
            Fidelity.Image.Resvg.resvg_options_destroy (Some opts)
            0n
        else

        match Fidelity.Libc.Memory.malloc (unativeint bufferSize) with
        | None ->
            Console.writeln "Platform.Display: pixmap malloc failed"
            Fidelity.Libc.Memory.free (Some treePtrStorage)
            Fidelity.Image.Resvg.resvg_options_destroy (Some opts)
            0n
        | Some pix ->
            let _ = Fidelity.Libc.Memory.memset (Some pix) 0 (unativeint bufferSize)

            // Read tree pointer from out-param storage
            let treePtr = NativePtr.read (NativePtr.ofNativeInt<nativeint> treePtrStorage)

            // Render SVG with identity transform (constructed manually —
            // resvg_transform_identity is a FidelityExtern that returns zeroed memory)
            let transform = { a = 1.0f; b = 0.0f; c = 0.0f; d = 1.0f; e = 0.0f; f = 0.0f }
            Fidelity.Image.Resvg.resvg_render (Some treePtr) transform (uint32 width) (uint32 height)
                (Some (NativePtr.ofNativeInt<byte> pix))

            // Clean up tree and options
            Fidelity.Image.Resvg.resvg_tree_destroy (Some treePtr)
            Fidelity.Libc.Memory.free (Some treePtrStorage)
            Fidelity.Image.Resvg.resvg_options_destroy (Some opts)
            pix

/// Rasterize an SVG file into a pixel buffer.
/// Returns pixel buffer handle on success, 0n on failure.
/// Caller is responsible for freeing the buffer via freePixmap.
let rasterize (svgPath: string) (width: int) (height: int) : nativeint =
    rasterizeStyled svgPath width height ""

/// Free a pixel buffer returned by rasterize.
let freePixmap (pixmap: nativeint) : unit =
    Fidelity.Libc.Memory.free (Some pixmap)
