[package]
name = "Fidelity.Platform.MCU.Renesas.RA6M5.EK_RA6M5"
version = "0.1.0"
authors = ["SpeakEZ Technologies"]
description = "MCU substrate binding metadata scaffold for Renesas EK-RA6M5."

[compilation]
target = "mcu"

[build]
sources = [
    "Platform.clef"
]
output = "fidelity-platform-mcu-ra6m5-ek-ra6m5"
output_kind = "library"

[platform]
runtime_model = "bare"
os = "none"
arch = "arm_cortex_m33"

[dependencies]
contracts = { path = "../../../../Contracts/Fidelity.Platform.Contracts.fidproj" }
