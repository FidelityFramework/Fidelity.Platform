[package]
name = "Fidelity.Platform.MCU.Renesas.RA6M5.EK_RA6M5"
version = "0.1.0"
authors = ["SpeakEZ Technologies"]
description = "MCU core, memory and initial MMIO declarations for Renesas EK-RA6M5."

[compilation]
target = "mcu"

[build]
sources = [
    "PackagePins.fs",
    "BoardNets.fs",
    "Description.fs",
    "Registers.clef"
]
output = "fidelity-platform-mcu-ra6m5-ek-ra6m5"
output_kind = "library"

[platform]
runtime_model = "bare"
os = "none"
arch = "arm_cortex_m33"

[dependencies]
BAREWire = { path = "../../../../../BAREWire/src/BAREWire.PlatformMetadata.fidproj" }
